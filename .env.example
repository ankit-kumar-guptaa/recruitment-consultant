# Public site URL used for canonical tags, sitemap and OG metadata
NEXT_PUBLIC_SITE_URL=https://recruitmentconsultant.co.in

# ---------------------------------------------------------------------------
# SMTP — enquiry and CV delivery
# Copy this file to .env.local (never commit .env.local) and fill in real values.
# Port 465 uses implicit TLS; use 587 if your host requires STARTTLS.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=noreply@example.com
SMTP_PASS=replace-me

# Envelope "from" address. Must be an address the SMTP account is allowed to
# send as — normally the same as SMTP_USER.
MAIL_FROM=noreply@example.com

# Where enquiries and CVs are delivered.
MAIL_TO=admin@example.com
