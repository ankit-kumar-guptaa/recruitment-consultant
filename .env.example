# Copy this file to .env.local and fill in real values.
# .env.local is gitignored. NEVER put a real credential in this file —
# .env.example is committed, and this repository is public.

# Public site URL used for canonical tags, sitemap, robots.txt and OG metadata.
#
# This MUST be the host that actually serves a 200 — not one that redirects to
# it. If Vercel's primary domain is www, this has to be the www URL, and vice
# versa. A mismatch stops Google indexing the site: every canonical points at a
# redirect, and the page it redirects to claims the redirect as its canonical.
# Run `npm run check:canonical` after any domain change to confirm.
NEXT_PUBLIC_SITE_URL=https://recruitmentconsultant.co.in

# ---------------------------------------------------------------------------
# Search Console & analytics (optional — the site works without them)
# ---------------------------------------------------------------------------
# The token from Search Console's "HTML tag" verification method: the
# content="..." value only, not the whole meta tag. Leave blank if the domain
# is verified by DNS instead.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# GA4 measurement ID (G-...). The live property's ID is the built-in default,
# so this only needs setting to point a deployment at a different property — or
# to the literal value "off", which disables it (useful for staging).
NEXT_PUBLIC_GA4_ID=

# Google Ads conversion tag (AW-...). Also defaulted to the live account, with
# the same "off" escape hatch. GA4 and Ads are separate products and both are
# loaded, through a single gtag.js loader.
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Google Ads conversion action, shaped like AW-16878629802/AbC-D_efGhIjK.
# Create it in Google Ads under Goals -> Conversions -> New conversion action
# -> Website, then paste the send_to value here. Until it is set, successful
# enquiries are reported to GA4 only and nothing is sent to Ads.
NEXT_PUBLIC_ADS_CONVERSION_LABEL=

# ---------------------------------------------------------------------------
# SMTP — enquiry and CV delivery
# Port 465 uses implicit TLS; use 587 if your host requires STARTTLS.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=noreply@example.com
SMTP_PASS=
# Envelope "from" address. Must be an address the SMTP account may send as —
# normally the same as SMTP_USER.
MAIL_FROM=noreply@example.com
# Where enquiries and CVs are delivered.
MAIL_TO=

# ---------------------------------------------------------------------------
# MySQL — enquiry storage (optional)
#
# Leave these blank and the site works exactly as before: enquiries are emailed
# and logged, just not stored. Set them and every submission is also written to
# the `enquiries` table (create it with db/001-enquiries.sql).
#
# On Hostinger:
#  - DB_HOST is the srvNNNN.hstgr.io name from hPanel, NOT localhost.
#  - DB_NAME and DB_USER carry an account prefix, e.g. u141142577_rc_db. The
#    short name will not work and the error does not mention the prefix.
#  - Remote MySQL must be enabled before anything outside Hostinger connects.
# See docs/DATABASE-SETUP.md.
# ---------------------------------------------------------------------------
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=
