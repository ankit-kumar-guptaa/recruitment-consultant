# Copy this file to .env.local and fill in real values.
# .env.local is gitignored. NEVER put a real credential in this file —
# .env.example is committed, and this repository is public.

# Public site URL used for canonical tags, sitemap and OG metadata.
# This must match the domain the site is actually served from, or Google will
# see canonicals pointing at a domain that does not serve the page.
NEXT_PUBLIC_SITE_URL=https://recruitmentconsultant.co.in

# ---------------------------------------------------------------------------
# Search Console & analytics (optional — the site works without them)
# ---------------------------------------------------------------------------
# The token from Search Console's "HTML tag" verification method: the
# content="..." value only, not the whole meta tag. Leave blank if the domain
# is verified by DNS instead.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# GA4 measurement ID. The live property's ID is the built-in default, so this
# only needs setting to point a deployment at a different property — or to the
# literal value "off", which disables analytics entirely (useful for staging).
NEXT_PUBLIC_GA4_ID=

# ---------------------------------------------------------------------------
# SMTP — enquiry and CV delivery
# Port 465 uses implicit TLS; use 587 if your host requires STARTTLS.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=noreply@example.com
SMTP_PASS=
# Envelope "from" address. Must be an address the SMTP account may send as —
# normally the same as SMTP_USER.
MAIL_FROM=noreply@example.com
# Where enquiries and CVs are delivered.
MAIL_TO=
