# ── RecruitmentConsultant.co.in — Apache rules for Next.js static export ──────

Options -Indexes
ServerSignature Off

# ── PHP passthrough (contact form) ────────────────────────────────────────────
<FilesMatch "\.php$">
    SetHandler application/x-httpd-php
</FilesMatch>

# ── Security headers ───────────────────────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-XSS-Protection "1; mode=block"

    # Cache _next/static assets forever (content-hashed filenames)
    <FilesMatch "\.(js|css|woff2?|ttf|eot|svg|png|jpg|jpeg|gif|ico|webp|avif)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # No-cache for HTML files
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# ── Compression ────────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json text/plain text/xml
</IfModule>

# ── Rewrite engine (routes without .html extension) ───────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Let actual files and directories pass through unchanged
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Serve .html version of clean URLs (e.g. /about → /about.html)
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.+?)/?$ /$1.html [L]

    # 404 fallback → /404.html
    RewriteRule ^ /404.html [L]
</IfModule>

# ── Custom error pages ─────────────────────────────────────────────────────────
ErrorDocument 404 /404.html
